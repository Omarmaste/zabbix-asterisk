# =============================================================
# CONFIGURACIÓN GLOBAL — zabbix-asterisk
# Plantilla para un cliente NUEVO. Copia este archivo a ".env"
# (en la RAÍZ del proyecto, junto a install_zabbix.sh) y rellena
# los valores reales. ".env" nunca se commitea (está en .gitignore).
#
#   cp .env.example .env
#   nano .env
#
# Ejemplo de instalación solo con latencia + NR + estado (sin
# módulos de Asterisk/SIP/PJSIP):
#
#   bash install_zabbix.sh --skip-ast_fail2ban --skip-ast_sip \
#                           --skip-ast_pjsip --skip-ast_countcalls_latency
#
# Con GRAFANA_DASHBOARD_UID vacío (como queda abajo), el propio
# install_zabbix.sh crea el tablero y la carpeta en Grafana la
# primera vez que corre (mismo formato que "wvx - npls - Latencia
# Agentes") y guarda el UID resultante en este mismo archivo, para
# que las corridas siguientes (cron nocturno) reutilicen el mismo
# tablero en vez de crear uno nuevo cada vez.
# =============================================================

# =============================================================
# ZABBIX — Credenciales y servidor
# Si este cliente usa el MISMO Zabbix/Grafana que npls/continente/
# nikoaventura (servidor 68.183.116.34 + tablero.aloglobal.com),
# ZBX_PASS/GRAFANA_TOKEN/GRAFANA_PASS son compartidos: copialos del
# .env de otro cliente en ESTE MISMO servidor (nunca via git/commit).
# =============================================================
ZBX_URL="http://68.183.116.34/zabbix/api_jsonrpc.php"
ZBX_USER="Admin"
ZBX_PASS="CHANGE_ME"
ZBX_SERVER="68.183.116.34"
ZBX_PORT="10051"
ZBX_VERIFY_TLS="false"
GRAFANA_HOST_FILTER="Zabbix server"
GRAFANA_GROUP_FILTER="Zabbix servers"

# =============================================================
# HOST ZABBIX — Todos los módulos de este servidor usan el mismo.
# Debe existir en Zabbix ANTES de instalar (Data collection > Hosts).
# Para anular uno en particular, descomenta su override abajo.
# =============================================================
ZBX_HOST="CHANGE_ME"

# Overrides por módulo (descomentar solo si difiere de ZBX_HOST)
# LATENCY_ZBX_HOST=""
# ZBX_HOST_SIP=""
# ZBX_HOST_PJSIP=""
# ZBX_HOST_COUNTCALLS=""
# ZBX_HOST_COUNTCALLS_PJSIP=""
# ZBX_HOST_FAIL2BAN=""

# =============================================================
# WOLKVOX API
# WOLKVOX_OPERATION es el prefijo usado en las keys de los items
# Zabbix ({OPERACION}.agent.latency[...]) y en el título/carpeta
# del tablero de Grafana que se crea automáticamente (ver abajo).
# =============================================================
WOLKVOX_URL="https://wvXXXX.wolkvox.com/api/v2/real_time.php"
WOLKVOX_SERVER="CHANGE_ME"
WOLKVOX_TOKEN="CHANGE_ME"
WOLKVOX_OPERATION="CHANGE_ME"

# =============================================================
# TIMEZONE
# Usada para el tablero de Grafana que se crea automáticamente (ver
# GRAFANA_TIMEZONE mas abajo, que cae a este valor si no se define).
# =============================================================
TIMEZONE_DEFAULT="America/Bogota"

# =============================================================
# LATENCY AGENT — Rutas de datos en tiempo de ejecución
# Deben apuntar EXACTAMENTE a la carpeta donde clonaste este repo en
# este servidor — la misma carpeta donde queda install_zabbix.sh al
# hacer `git clone <url> .` (NO le agregues una subcarpeta extra tipo
# "zabbix-asterisk" a menos que vos mismo hayas clonado ahí adentro).
# Verificalo con: cd <tu_clone> && pwd
# =============================================================
LATENCY_BASE_DIR="/etc/zabbix/scripts/wvx/CHANGE_ME_RUTA_DEL_CLONE"
LATENCY_LOG_DIR="/etc/zabbix/scripts/wvx/CHANGE_ME_RUTA_DEL_CLONE"

# =============================================================
# GRAFANA
# GRAFANA_DASHBOARD_UID vacío = install_zabbix.sh crea el tablero
# (y la carpeta, si no existe) automáticamente en el primer run y
# guarda el UID aquí mismo. Si ya tienes un tablero armado a mano,
# pega su UID (se saca de la URL /d/<UID>/... en Grafana) y el
# script lo reutiliza en vez de crear uno nuevo.
# GRAFANA_FOLDER_TITLE / GRAFANA_DASHBOARD_TITLE son opcionales:
# si no se definen, se derivan de WOLKVOX_OPERATION
# ("wvx - <OPERATION>" / "wvx - <OPERATION> - Latencia Agentes").
# GRAFANA_TIMEZONE es opcional: si no se define, se usa TIMEZONE_DEFAULT.
# =============================================================
GRAFANA_URL="https://tablero.aloglobal.com"
GRAFANA_DASHBOARD_UID=""
# GRAFANA_FOLDER_TITLE="wvx - expresodemonte"
# GRAFANA_DASHBOARD_TITLE="wvx - expresodemonte - Latencia Agentes"
# GRAFANA_TIMEZONE="America/Bogota"
# bep9lrd00y5fkd = datasource Zabbix compartido, mismo para todos los clientes de este Grafana
GRAFANA_DS_UID="bep9lrd00y5fkd"
GRAFANA_TOKEN="CHANGE_ME"
# GRAFANA_USER="admin"
# GRAFANA_PASS="CHANGE_ME"

# =============================================================
# ASTERISK / ZABBIX AGENT
# (Irrelevante si instalas solo wvx_latency_nr)
# =============================================================
ASTERISK_BIN="/usr/sbin/asterisk"
ZABBIX_CONF="/etc/zabbix/zabbix_agentd.conf"
SCRIPTS_DIR="/etc/zabbix/scripts"

# =============================================================
# GENERAL
# =============================================================
DEBUG="false"
PEER_SOURCE="agent_conf"
EXTRA_PEERS=""
